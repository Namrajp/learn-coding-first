---
import { getCategory } from "../lib/categories";

const { tags, category } = Astro.props;
const pathname = Astro.url.pathname;
const segments = pathname.split("/").filter(Boolean);

const formatLabel = (segment: string) => {
  const decoded = decodeURIComponent(segment).replace(/-/g, " ");
  return decoded.replace(/\b\w/g, (char) => char.toUpperCase());
};

const items: { label: string; href?: string }[] = [
  { label: "Home", href: "/" },
];

const postCategory = category ? getCategory(category) : undefined;

// A post page — build Home / Blog / Category / Post
if (postCategory && segments.length === 1) {
  items.push({ label: "Blog", href: "/blog" });
  items.push({
    label: postCategory.label,
    href: `/category/${postCategory.slug}`,
  });
  items.push({ label: formatLabel(segments[0]) });
} else if (tags && tags.length > 0 && segments.length === 1) {
  const firstTag = tags[0];
  items.push({ label: formatLabel(firstTag), href: `/tag/${firstTag}` });
  items.push({ label: formatLabel(segments[0]) });
} else {
  let currentPath = "";

  segments.forEach((segment, index) => {
    currentPath += `/${segment}`;
    const next = segments[index + 1];

    if (segment === "page" && next && /^\d+$/.test(next)) {
      return;
    }

    // "tag" and "category" are route prefixes, not pages of their own. Skip
    // them so only the slug that follows gets a crumb.
    if ((segment === "tag" || segment === "category") && next) {
      return;
    }

    const label =
      segment === "page" && next
        ? `Page ${next}`
        : segments[index - 1] === "category"
          ? (getCategory(segment)?.label ?? formatLabel(segment))
          : formatLabel(segment);

    if (!label) {
      return;
    }

    items.push({
      label,
      href: index === segments.length - 1 ? undefined : currentPath,
    });
  });
}

const visibleItems = items.filter((item) => item.label);

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: visibleItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: item.href ? `https://learncodingfirst.com${item.href}` : undefined,
  })),
};
---

{
  visibleItems.length > 1 && (
    <nav
      aria-label="Breadcrumb"
      class="mb-6 flex flex-wrap items-center justify-center gap-2 text-sm text-gray-600 dark:text-gray-400"
    >
      {visibleItems.map((item, index) => (
        <>
          {index > 0 && (
            <span aria-hidden="true" class="text-gray-400">
              /
            </span>
          )}
          {index === visibleItems.length - 1 || !item.href ? (
            <span class="font-semibold text-gray-900 dark:text-gray-100">
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              class="text-[hsl(21,62%,45%)] no-underline hover:text-[hsl(21,62%,35%)]"
            >
              {item.label}
            </a>
          )}
        </>
      ))}
    </nav>
  )
}
<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbJsonLd)}
/>
