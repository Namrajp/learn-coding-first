---
const { tags } = Astro.props;
const pathname = Astro.url.pathname;
const segments = pathname.split("/").filter(Boolean);

const formatLabel = (segment: string) => {
  const decoded = decodeURIComponent(segment).replace(/-/g, " ");
  return decoded.replace(/\b\w/g, (char) => char.toUpperCase());
};

const items: { label: string; href?: string }[] = [{ label: "Home", href: "/" }];

// If we have tags, this is a post page — build Home / Tag / Post
if (tags && tags.length > 0 && segments.length === 1) {
  const firstTag = tags[0];
  const postTitle = formatLabel(segments[0]);
  items.push({ label: formatLabel(firstTag), href: `/tag/${firstTag}` });
  items.push({ label: postTitle });
} else {
  let currentPath = "";

  segments.forEach((segment, index) => {
    currentPath += `/${segment}`;
    const next = segments[index + 1];

    if (segment === "page" && next && /^\d+$/.test(next)) {
      return;
    }

    if (segment === "tag" && next) {
      items.push({
        label: formatLabel(next),
        href: index === segments.length - 1 ? undefined : `/tag/${next}`,
      });
      return;
    }

    const label =
      segment === "page" && next ? `Page ${next}` : formatLabel(segment);

    if (!label) {
      return;
    }

    items.push({
      label,
      href: index === segments.length - 1 ? undefined : currentPath,
    });
  });
}

const visibleItems = items.filter((item) => item.label);
---

{
  visibleItems.length > 1 && (
    <nav
      aria-label="Breadcrumb"
      class="mb-6 flex flex-wrap items-center justify-center gap-2 text-sm text-gray-600 dark:text-gray-400"
    >
      {visibleItems.map((item, index) => (
        <>
          {index > 0 && (
            <span aria-hidden="true" class="text-gray-400">
              /
            </span>
          )}
          {index === visibleItems.length - 1 || !item.href ? (
            <span class="font-semibold text-gray-900 dark:text-gray-100">{item.label}</span>
          ) : (
            <a
              href={item.href}
              class="text-[hsl(21,62%,45%)] underline hover:text-[hsl(21,62%,35%)]"
            >
              {item.label}
            </a>
          )}
        </>
      ))}
    </nav>
  )
}
