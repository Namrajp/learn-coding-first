---
const { showSignOut = false } = Astro.props;
---

<div class="fixed top-4 right-4 z-[100] flex items-center gap-2">
  <button
    id="theme-toggle"
    class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-700 shadow-sm transition-colors hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
    aria-label="Toggle dark mode"
  >
    <svg
      id="sun-icon"
      class="hidden h-5 w-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
      ></path>
    </svg>
    <svg
      id="moon-icon"
      class="hidden h-5 w-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
      ></path>
    </svg>
  </button>
  {
    showSignOut && (
      <button
        id="logout-btn"
        class="flex h-10 items-center gap-1 rounded-full border border-gray-200 bg-white px-3 text-sm text-gray-700 shadow-sm transition-colors hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
      >
        Sign Out
      </button>
    )
  }
</div>

<script>
  function getTheme(): string {
    const stored = localStorage.getItem("theme");
    if (stored) return stored;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  }

  function updateIcons(theme: string) {
    const sunIcon = document.getElementById("sun-icon");
    const moonIcon = document.getElementById("moon-icon");
    if (sunIcon && moonIcon) {
      sunIcon.classList.toggle("hidden", theme === "light");
      moonIcon.classList.toggle("hidden", theme === "dark");
    }
  }

  function applyTheme(theme: string) {
    const root = document.documentElement;
    if (theme === "dark") {
      root.classList.add("dark");
    } else {
      root.classList.remove("dark");
    }
    localStorage.setItem("theme", theme);
    updateIcons(theme);
  }

  function setupToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    // Remove old listener by replacing element
    const newBtn = btn.cloneNode(true);
    btn.parentNode?.replaceChild(newBtn, btn);
    newBtn.addEventListener("click", () => {
      const current = document.documentElement.classList.contains("dark")
        ? "dark"
        : "light";
      applyTheme(current === "dark" ? "light" : "dark");
    });
  }

  // Initial setup
  applyTheme(getTheme());
  setupToggle();

  // Re-setup after Astro view transitions
  document.addEventListener("astro:after-swap", () => {
    applyTheme(getTheme());
    setupToggle();
    setupLogout();
  });

  function setupLogout() {
    const logoutBtn = document.getElementById("logout-btn");
    if (!logoutBtn) return;
    const newBtn = logoutBtn.cloneNode(true);
    logoutBtn.parentNode?.replaceChild(newBtn, logoutBtn);
    newBtn.addEventListener("click", async () => {
      const { authClient } = await import("../lib/auth-client");
      await authClient.signOut();
      window.location.href = "/login";
    });
  }

  setupLogout();
</script>
