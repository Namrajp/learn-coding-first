---
import { AUTHOR, SOCIAL_LINKS, authorPersonSchema } from "../lib/site";

const personSchema = authorPersonSchema();
---

<section
  aria-label="About the author"
  class="mx-auto mb-10 max-w-2xl text-center"
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <div
    class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-[hsl(21,62%,45%)] text-xl font-bold text-white"
    aria-hidden="true"
  >
    NP
  </div>
  <h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100">
    {AUTHOR.name}
  </h2>
  <p class="mb-4 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
    {AUTHOR.bio}
  </p>
  <div class="flex flex-wrap justify-center gap-3">
    {
      SOCIAL_LINKS.map((link) => (
        <a
          href={link.href}
          rel={link.rel}
          target="_blank"
          class="min-w-[80px] rounded-lg border border-gray-300 px-3 py-1.5 text-center text-sm font-medium text-gray-700 no-underline hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</section>
