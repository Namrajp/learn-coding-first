---
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => post.data.status !== "draft")
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .slice(0, 4);
---

{
  posts.length > 0 && (
    <section class="mb-8">
      <h3 class="mb-3 text-center text-sm font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
        Popular Posts
      </h3>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-center">
        {posts.map((post) => (
          <li>
            <a
              href={`/${post.id}`}
              class="text-sm font-medium text-gray-600 no-underline hover:text-[hsl(21,62%,45%)] dark:text-gray-400 dark:hover:text-[hsl(21,62%,55%)]"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
