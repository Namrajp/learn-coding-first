---
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => post.data.status !== "draft")
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .slice(0, 4);
---

{
  posts.length > 0 && (
    <section class="mx-auto mb-8 max-w-2xl">
      <h3 class="mb-3 text-center text-sm font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
        Popular Posts
      </h3>
      <ul class="mx-auto w-fit list-none flex flex-col items-start gap-y-2 text-left">
        {posts.map((post) => (
          <li class="text-sm font-medium text-gray-600 dark:text-gray-400">
            <span class="mr-2 text-gray-400 dark:text-gray-500">-</span>
            <a
              href={`/${post.id}`}
              class="no-underline hover:text-[hsl(21,62%,45%)] dark:hover:text-[hsl(21,62%,55%)]"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
