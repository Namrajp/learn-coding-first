---
interface Props {
  tags: string[];
  tagCounts?: Record<string, number>;
}

const { tags, tagCounts } = Astro.props;

const sortedTags = tagCounts
  ? [...tags].sort((a, b) => (tagCounts[b] || 0) - (tagCounts[a] || 0))
  : tags;
---

<aside class="px-4 py-4 md:px-6 md:py-0">
  <h2
    class="mb-3 text-2xl font-black tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100"
  >
    <span class="text-[hsl(21,62%,45%)]">Learn</span> CODING <span
      class="text-[hsl(21,62%,45%)]">First</span
    >
  </h2>
  <div class="my-4 max-h-[300px] overflow-y-auto pr-2 sm:max-h-[400px]">
    <ol
      class="flex flex-wrap gap-2 list-none list-inside text-slate-700 sm:flex-col sm:gap-0 sm:space-y-2 sm:list-hyphen dark:text-slate-300"
    >
      {
        sortedTags.map((tag) => (
          <li>
            <a
              href={`/tag/${tag}`}
              class="capitalize no-underline rounded-full bg-gray-100 px-3 py-1 text-sm hover:bg-gray-200 hover:text-[hsl(21,62%,45%)] sm:bg-transparent sm:px-0 sm:py-0 sm:text-base dark:bg-gray-800 dark:hover:bg-gray-700"
            >
              {tag}
              {tagCounts && tagCounts[tag] && (
                <span class="ml-1 text-xs text-gray-400">({tagCounts[tag]})</span>
              )}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</aside>
