---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<aside class="max-h-[calc(100vh-140px)] overflow-y-auto px-4 md:px-6 md:pr-6">
  <h2 class="mb-3 text-4xl font-black tracking-tight text-slate-900">
    <span class="text-[hsl(21,62%,45%)]">Learn</span> CODING <span
      class="text-[hsl(21,62%,45%)]">First</span
    >
  </h2>
  <ol class="my-4 list-inside list-decimal space-y-3 text-slate-700">
    {
      tags.map((tag) => (
        <li>
          <a
            href={`/tag/${tag}`}
            class="capitalize no-underline hover:text-[hsl(21,62%,45%)]"
          >
            {tag}
          </a>
        </li>
      ))
    }
  </ol>
</aside>
