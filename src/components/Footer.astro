---
import NewsletterSignup from "./NewsletterSignup.astro";
import PopularPosts from "./PopularPosts.astro";
import AuthorBio from "./AuthorBio.astro";

interface Props {
  user?: { email?: string } | null;
}

const { user } = Astro.props;
---

<footer class="mt-20 border-t-2 border-gray-300 pt-12 dark:border-gray-700">
  <NewsletterSignup />
  <PopularPosts />
  <AuthorBio />
  <nav class="flex justify-center space-x-10 pb-10">
    <a
      href="/"
      class="font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >Home</a
    >
    <a
      href="/blog"
      class="font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >Blog</a
    >
    <a
      href={user ? "/admin" : "/login"}
      class="font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
    >
      {user ? "Admin" : "Login"}
    </a>
  </nav>
  <p class="text-center text-gray-400">
    &copy; {new Date().getFullYear()} Learn Coding First. All rights reserved.
  </p>
</footer>
