---
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
import Breadcrumb from "../components/Breadcrumb.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
const { frontmatter, title } = Astro.props;


---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={frontmatter?.description
        ? frontmatter.description
        : "My awesome blog"}
    />
    <meta property="og:image" content={`https://learncodingfirst.com/my-logo.svg`} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.14.0/css/all.min.css"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="My cool blog"
      href="/rss.xml"
    />
    <title>{title}</title>

    <style is:global>
      h1 {
        font-size: 1.5rem;
        font-weight: bold;
      }
      .svg-container {
        max-width: 200px;
        margin: auto;
      }
      .svg-circle:hover + .svg-text-group {
        opacity: 0;
      }
    </style>

    <ClientRouter />
  </head>
  <body class="px-5 pt-3 pb-5 overflow-x-hidden">
    <div class="py-2">
      <header id="home">
        <!-- <Nav /> -->
      </header>
      {
        frontmatter?.title && (
          <h1 class="mt-10 text-center text-3xl mb-10 font-extrabold tracking-tight text-gray-900">
            {frontmatter.title}
          </h1>
        )
      }

      <div class="mx-auto max-w-[1200px] px-6">
        <Breadcrumb />
        <slot />
      </div>
      <!-- <Footer /> -->
    </div>
    <script src="/src/main.ts"></script>
  </body>
</html>
