---
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
import Breadcrumb from "../components/Breadcrumb.astro";
import Footer from "../components/Footer.astro";
import { AUTHOR, SOCIAL_LINKS } from "../lib/site";
const {
  frontmatter,
  title,
  tags,
  showSignOut,
  canonical,
  robots,
  description,
  ogImage,
  author,
  pageType,
} = Astro.props;
const user = Astro.locals.user ?? null;

const metaDescription =
  description ||
  frontmatter?.description ||
  "Learn programming and AI fundamentals";
const metaOgImage = ogImage || "https://learncodingfirst.com/og-default.png";
const metaAuthor = author || AUTHOR.name;
const metaPageType = pageType || "website";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Learn Coding First",
  url: "https://learncodingfirst.com",
  description: "Programming, AI, and developer tutorials",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://learncodingfirst.com/blog?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#d4601a" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://api.github.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />
    {
      SOCIAL_LINKS.map((link) => (
        <link rel="me" href={link.href} />
      ))
    }
    <meta name="google-site-verification" content="XGluNkoesK7Q1TLP07cdzPkFPe9w-_pj_VyTHJsjz2A" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical || Astro.url.href} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="description" content={metaDescription} />
    <meta name="author" content={metaAuthor} />

    <!-- Open Graph -->
    <meta property="og:type" content={metaPageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Learn Coding First" />
    <meta property="og:image" content={metaOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaOgImage} />
    <meta name="twitter:creator" content="@wouraj" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Learn Coding First"
      href="/rss.xml"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title} | Learn Coding First</title>

    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "1ec7db8a5033408d80f39f0f42289faa"}'></script>
    <!-- End Cloudflare Web Analytics -->

    <style is:global>
      html {
        color-scheme: light;
      }
      html.dark {
        color-scheme: dark;
      }
      h1 {
        font-size: 1.5rem;
        font-weight: bold;
      }
      .svg-container {
        max-width: 200px;
        margin: auto;
      }
      .svg-circle:hover + .svg-text-group {
        opacity: 0;
      }
    </style>

    <ClientRouter />
  </head>
  <body
    class="overflow-x-hidden bg-[rgb(var(--color-bg-body))] px-5 pt-3 pb-5 font-sans text-gray-900 transition-colors dark:bg-gray-950 dark:text-gray-100"
  >
    <div class="py-2">
      <div class="mx-auto max-w-[1200px] px-6">
        <Breadcrumb {tags} />
        <slot />
      </div>
      <Footer {user} {showSignOut} />
    </div>
  </body>
</html>
