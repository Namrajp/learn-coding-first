---
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
import Breadcrumb from "../components/Breadcrumb.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";
const { frontmatter, title, tags, showSignOut } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={frontmatter?.description
        ? frontmatter.description
        : "My awesome blog"}
    />
    <meta
      property="og:image"
      content={`https://learncodingfirst.com/my_logo.svg`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Learn Coding First"
      href="/rss.xml"
    />
    <title>{title}</title>

    <style is:global>
      html {
        color-scheme: light;
      }
      html.dark {
        color-scheme: dark;
      }
      h1 {
        font-size: 1.5rem;
        font-weight: bold;
      }
      .svg-container {
        max-width: 200px;
        margin: auto;
      }
      .svg-circle:hover + .svg-text-group {
        opacity: 0;
      }
    </style>

    <ClientRouter />
  </head>
  <body class="overflow-x-hidden px-5 pt-3 pb-5 bg-white text-gray-900 transition-colors dark:bg-gray-950 dark:text-gray-100">
    <ThemeToggle showSignOut={showSignOut} />
    <div class="py-2">
      <header id="home">
      </header>

      <div class="mx-auto max-w-[1200px] px-6">
        <Breadcrumb tags={tags} />
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
