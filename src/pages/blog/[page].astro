---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import TagSidebar from "../../components/TagSidebar.astro";

const q = Astro.url.searchParams.get("q") || "";
const tag = Astro.url.searchParams.get("tag") || "";
const pageNum = Number(Astro.params.page) || 1;

let posts = (await getCollection("posts")).filter(
  (post) => post.data.status !== "draft",
);

if (q) {
  const query = q.toLowerCase();
  posts = posts.filter(
    (p) =>
      p.data.title.toLowerCase().includes(query) ||
      p.data.tags.some((t) => t.toLowerCase().includes(query)),
  );
}

if (tag) {
  posts = posts.filter((p) => p.data.tags.includes(tag));
}

posts = posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);

const pageSize = 8;
const totalPosts = posts.length;
const lastPage = Math.max(1, Math.ceil(totalPosts / pageSize));
const safePage = Math.min(Math.max(1, pageNum), lastPage);
const start = (safePage - 1) * pageSize;
const pagePosts = posts.slice(start, start + pageSize);

const tags: string[] = [];
const tagCounts: Record<string, number> = {};
const allPosts = (await getCollection("posts")).filter(
  (post) => post.data.status !== "draft",
);
allPosts.forEach((post) => {
  post.data.tags.forEach((tagItem: string) => {
    if (!tags.includes(tagItem)) tags.push(tagItem);
    tagCounts[tagItem] = (tagCounts[tagItem] || 0) + 1;
  });
});

function blogPath(): string {
  const base = import.meta.env.BASE_URL || "/";
  return base.endsWith("/") ? `${base}blog` : `${base}/blog`;
}

function pageUrl(p: number): string {
  const params = new URLSearchParams();
  if (q) params.set("q", q);
  if (tag) params.set("tag", tag);
  const qs = params.toString();
  if (p === 1) return `${blogPath()}/`;
  return `${blogPath()}/${p}/${qs ? `?${qs}` : ""}`;
}

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, stale-while-revalidate=300",
);
---

<Layout
  title={`Blog Archive${q ? ` — "${q}"` : ""}${tag ? ` — #${tag}` : ""} — Page ${safePage} of ${lastPage}`}
>
  <div class="mx-auto w-full max-w-4xl text-left">
    <div class="grid gap-4 md:grid-cols-[250px_1fr] md:gap-8">
      <TagSidebar {tags} {tagCounts} />

      <section>
        <h1
          class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100"
        >
          Blog archive
        </h1>
        <p class="my-4 text-xl font-semibold dark:text-gray-200">
          List of all the blog posts
        </p>

        <form
          method="get"
          class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center"
        >
          <div class="relative flex-1">
            <svg
              class="absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
              type="text"
              name="q"
              value={q}
              placeholder="Search by title or tag..."
              class="w-full rounded-lg border border-gray-300 bg-white py-2 pr-4 pl-9 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white dark:focus:ring-[hsl(21,62%,45%)]"
            />
          </div>
          <select
            name="tag"
            class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white"
          >
            <option value="">All Tags</option>
            {
              tags.sort().map((t) => (
                <option value={t} selected={t === tag}>
                  {t}
                </option>
              ))
            }
          </select>
          <button
            type="submit"
            class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 text-sm font-medium text-white hover:bg-[hsl(21,62%,35%)]"
          >
            Search
          </button>
          {
            (q || tag) && (
              <a
                href={blogPath() + "/"}
                class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
              >
                Clear
              </a>
            )
          }
        </form>

        {
          (q || tag) && (
            <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
              {totalPosts} result{totalPosts !== 1 ? "s" : ""} found
              {q && (
                <span>
                  for "<strong>{q}</strong>"
                </span>
              )}
              {tag && (
                <span>
                  in tag <strong>#{tag}</strong>
                </span>
              )}
            </p>
          )
        }

        <ul class="space-y-2">
          {
            pagePosts.map((post) => (
              <li>
                <a
                  href={`/${post.id}`}
                  class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4"
                >
                  {post.data.title}
                </a>
                <span>({post.data.date.toLocaleDateString()})</span>
              </li>
            ))
          }
        </ul>

        {
          pagePosts.length === 0 && (
            <p class="py-8 text-center text-gray-500 dark:text-gray-400">
              No posts match your search.
            </p>
          )
        }

        {
          lastPage > 1 && (
            <>
              <p class="my-4">
                Page {safePage} of {lastPage}
              </p>
              <div class="flex gap-4">
                {safePage > 1 && (
                  <a
                    href={pageUrl(safePage - 1)}
                    class="rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
                  >
                    Previous
                  </a>
                )}
                {safePage < lastPage && (
                  <a
                    href={pageUrl(safePage + 1)}
                    class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
                  >
                    Next
                  </a>
                )}
              </div>
            </>
          )
        }
      </section>
    </div>
  </div>
</Layout>
