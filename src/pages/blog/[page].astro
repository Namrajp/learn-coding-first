---
import Layout from "@layouts/Layout.astro";
import TagSidebar from "../../components/TagSidebar.astro";
import PagefindSearch from "../../components/PagefindSearch.astro";
import {
  getPublishedPosts,
  getTagCounts,
  PAGE_SIZE,
} from "../../lib/blog-helpers";

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const { tags, tagCounts } = getTagCounts(allPosts);
  const lastPage = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));

  return Array.from({ length: lastPage - 1 }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * PAGE_SIZE;
    return {
      params: { page: String(page) },
      props: {
        pagePosts: allPosts.slice(start, start + PAGE_SIZE),
        safePage: page,
        lastPage,
        tags,
        tagCounts,
        totalPosts: allPosts.length,
      },
    };
  });
}

const { pagePosts, safePage, lastPage, tags, tagCounts } = Astro.props;
---

<Layout title={`Blog Archive — Page ${safePage} of ${lastPage}`}>
  <div class="mx-auto w-full max-w-4xl text-left">
    <div class="grid gap-4 md:grid-cols-[250px_1fr] md:gap-8">
      <TagSidebar {tags} {tagCounts} />

      <section>
        <h1
          class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100"
        >
          Blog archive
        </h1>
        <p class="my-4 text-xl font-semibold dark:text-gray-200">
          List of all the blog posts
        </p>

        <PagefindSearch {tags} />

        <ul id="post-list" class="space-y-2">
          {
            pagePosts.map((post) => (
              <li
                class="blog-post"
                data-title={post.data.title.toLowerCase()}
                data-tags={post.data.tags.join(",")}
                data-description={post.data.description.toLowerCase()}
              >
                <a
                  href={`/${post.id}`}
                  class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4"
                >
                  {post.data.title}
                </a>
                <span class="text-gray-500 dark:text-gray-400">
                  ({post.data.date.toLocaleDateString()})
                </span>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                  {post.data.description}
                </p>
              </li>
            ))
          }
        </ul>

        <p id="no-results" class="hidden py-8 text-center text-gray-500 dark:text-gray-400">
          No posts match your search.
        </p>

        <div id="pagination" class="mt-4">
          <p class="mb-2">Page {safePage} of {lastPage}</p>
          <div class="flex gap-4">
            {safePage > 1 && (
              <a
                href={safePage - 1 === 1 ? "/blog/" : `/blog/${safePage - 1}`}
                class="rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
              >
                Previous
              </a>
            )}
            {safePage < lastPage && (
              <a
                href={`/blog/${safePage + 1}`}
                class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
              >
                Next
              </a>
            )}
          </div>
        </div>
      </section>
    </div>
  </div>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById("pagefind-search");
      const tagSelect = document.getElementById("tag-filter");
      const postList = document.getElementById("post-list");
      const noResults = document.getElementById("no-results");
      const pagination = document.getElementById("pagination");

      if (!searchInput || !tagSelect || !postList) return;

      function filterPosts() {
        const query = searchInput.value.toLowerCase().trim();
        const selectedTag = tagSelect.value;
        const posts = postList.querySelectorAll(".blog-post");
        let visibleCount = 0;

        posts.forEach((post) => {
          const title = post.getAttribute("data-title") || "";
          const tags = (post.getAttribute("data-tags") || "").split(",");
          const description = post.getAttribute("data-description") || "";

          const matchesQuery =
            !query ||
            title.includes(query) ||
            description.includes(query) ||
            tags.some((t) => t.includes(query));
          const matchesTag = !selectedTag || tags.includes(selectedTag);

          if (matchesQuery && matchesTag) {
            post.style.display = "";
            visibleCount++;
          } else {
            post.style.display = "none";
          }
        });

        if (noResults) {
          noResults.classList.toggle("hidden", visibleCount > 0);
        }
        if (pagination) {
          pagination.classList.toggle("hidden", visibleCount === 0 || query || selectedTag);
        }
      }

      searchInput.addEventListener("input", filterPosts);
      tagSelect.addEventListener("change", filterPosts);
    });
  </script>
</Layout>
