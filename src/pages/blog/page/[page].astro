---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";

import type { Page, PaginateFunction } from "astro";

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  let posts = await getCollection("posts");
  posts = posts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
  );

  return paginate(posts, { pageSize: 8 });
}

const { page } = Astro.props as { page: Page };
const tags: string[] = [];

page.data.forEach((post) => {
  post.data.tags.forEach((tagItem: string) => {
    if (!tags.includes(tagItem)) tags.push(tagItem);
  });
});

const currentPageLabel = (() => {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  const tagIndex = segments.indexOf("tag");

  if (tagIndex >= 0) {
    return segments[tagIndex + 1] ?? "Blog";
  }

  return "Blog archive";
})();
---

<Layout title="Blog archive">
  <div class="w-full max-w-[90vw] mx-auto text-left">
    <div class="grid gap-8 md:grid-cols-[30%_70%]">
      <aside class="md:pr-6 max-h-[calc(100vh-140px)] overflow-y-auto">
        <h2 class="text-4xl font-black tracking-tight text-slate-900 mb-3">
          <span class="text-[hsl(21,62%,45%)]">Learn</span> CODING <span class="text-[hsl(21,62%,45%)]">First</span>
        </h2>

        <ol class="my-4 space-y-3 list-decimal list-inside text-slate-700">
          {
            tags.map((tag) => (
              <li>
                <a href={`/tag/${tag}`} class="capitalize no-underline hover:text-[hsl(21,62%,45%)]">
                  {tag}
                </a>
              </li>
            ))
          }
        </ol>
      </aside>

      <section>
        <h1 class="text-5xl font-extrabold tracking-tight text-slate-900 mb-4">
          Blog archive
        </h1>
        <p class="my-4 text-xl font-semibold">List of all the blog posts</p>

        <ul class="space-y-2">
          {
            page.data.map((post) => (
              <li>
                <a href={`/blog/${post.id}`} class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4">
                  {post.data.title}
                </a>
                <span>({post.data.date.toLocaleDateString()})</span>
              </li>
            ))
          }
        </ul>

        <p class="my-4">Page {page.currentPage} of {page.lastPage}</p>
        {
          page.url.next && (
            <p>
              <a href={page.url.next}>
                Next
              </a>
            </p>
          )
        }
        {
          page.url.prev && (
            <p>
              <a href={page.url.prev}>
                Previous
              </a>
            </p>
          )
        }
      </section>
    </div>
  </div>
</Layout>
