---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import TagSidebar from "../../../components/TagSidebar.astro";

import type { Page, PaginateFunction } from "astro";

export const prerender = true;

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  let posts = await getCollection("posts");
  posts = posts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );

  return paginate(posts, { pageSize: 8 });
}

const { page } = Astro.props as { page: Page };
const tags: string[] = [];
const tagCounts: Record<string, number> = {};

const allPosts = await getCollection("posts");
allPosts.forEach((post) => {
  post.data.tags.forEach((tagItem: string) => {
    if (!tags.includes(tagItem)) tags.push(tagItem);
    tagCounts[tagItem] = (tagCounts[tagItem] || 0) + 1;
  });
});
---

<Layout title={`Blog Archive - Page ${page.currentPage} of ${page.lastPage}`}>
  <div class="mx-auto w-full max-w-4xl text-left">
    <div class="grid gap-4 md:grid-cols-[250px_1fr] md:gap-8">
      <TagSidebar tags={tags} {tagCounts} />

      <section>
        <h1
          class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100"
        >
          Blog archive
        </h1>
        <p class="my-4 text-xl font-semibold dark:text-gray-200">
          List of all the blog posts
        </p>

        <ul class="space-y-2">
          {
            page.data.map((post) => (
              <li>
                <a
                  href={`/${post.id}`}
                  class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4"
                >
                  {post.data.title}
                </a>
                <span>({post.data.date.toLocaleDateString()})</span>
              </li>
            ))
          }
        </ul>

        <p class="my-4">Page {page.currentPage} of {page.lastPage}</p>
        <div class="flex gap-4">
          {
            page.url.prev && (
              <a
                href={page.url.prev}
                class="rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
              >
                Previous
              </a>
            )
          }
          {
            page.url.next && (
              <a
                href={page.url.next}
                class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
              >
                Next
              </a>
            )
          }
        </div>
      </section>
    </div>
  </div>
</Layout>
