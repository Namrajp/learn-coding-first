---
import Layout from "@layouts/Layout.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import TagSidebar from "../../components/TagSidebar.astro";
import { CATEGORIES, getCategory } from "../../lib/categories";
import {
  PAGE_SIZE,
  blogPath,
  filterPosts,
  getCategoryCounts,
  getPublishedPosts,
  getTagCounts,
  pageUrl,
} from "../../lib/blog-helpers";

const q = Astro.url.searchParams.get("q") || "";
const tag = Astro.url.searchParams.get("tag") || "";
const category = Astro.url.searchParams.get("category") || "";

const allPosts = await getPublishedPosts();
const posts = filterPosts(allPosts, { q, tag, category });

const totalPosts = posts.length;
const lastPage = Math.max(1, Math.ceil(totalPosts / PAGE_SIZE));
const pagePosts = posts.slice(0, PAGE_SIZE);

const { tags, tagCounts } = getTagCounts(allPosts);
const categoryCounts = getCategoryCounts(allPosts);
const activeCategory = getCategory(category);
const hasFilters = Boolean(q || tag || category);
const filters = { q, tag, category };
---

<Layout
  title={`Blog Archive${q ? ` — "${q}"` : ""}${tag ? ` — #${tag}` : ""}${activeCategory ? ` — ${activeCategory.label}` : ""}`}
>
  <div class="mx-auto w-full max-w-4xl text-left">
    <div class="grid gap-4 md:grid-cols-[250px_1fr] md:gap-8">
      <TagSidebar {tags} {tagCounts} />

      <section>
        <h1
          class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100"
        >
          Blog archive
        </h1>
        <p class="my-4 text-xl font-semibold dark:text-gray-200">
          List of all the blog posts
        </p>

        <form
          method="get"
          class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center"
        >
          <div class="relative flex-1">
            <svg
              class="absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
              type="text"
              name="q"
              value={q}
              placeholder="Search by title, tag, or description..."
              class="w-full rounded-lg border border-gray-300 bg-white py-2 pr-4 pl-9 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white dark:focus:ring-[hsl(21,62%,45%)]"
            />
          </div>
          <select
            name="category"
            class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white"
          >
            <option value="">All Categories</option>
            {
              CATEGORIES.filter((c) => (categoryCounts[c.slug] || 0) > 0).map(
                (c) => (
                  <option value={c.slug} selected={c.slug === category}>
                    {c.label}
                  </option>
                ),
              )
            }
          </select>
          <select
            name="tag"
            class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white"
          >
            <option value="">All Tags</option>
            {
              tags.map((t) => (
                <option value={t} selected={t === tag}>
                  {t}
                </option>
              ))
            }
          </select>
          <button
            type="submit"
            class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 text-sm font-medium text-white hover:bg-[hsl(21,62%,35%)]"
          >
            Search
          </button>
          {
            hasFilters && (
              <a
                href={blogPath() + "/"}
                class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
              >
                Clear
              </a>
            )
          }
        </form>

        <CategoryGrid counts={categoryCounts} active={category} />

        {
          hasFilters && (
            <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
              {totalPosts} result{totalPosts !== 1 ? "s" : ""} found
              {q && (
                <span>
                  for "<strong>{q}</strong>"
                </span>
              )}
              {activeCategory && (
                <span>
                  in <strong>{activeCategory.label}</strong>
                </span>
              )}
              {tag && (
                <span>
                  in tag <strong>#{tag}</strong>
                </span>
              )}
            </p>
          )
        }

        <ul class="space-y-2">
          {
            pagePosts.map((post) => (
              <li>
                <a
                  href={`/${post.id}`}
                  class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4"
                >
                  {post.data.title}
                </a>
                <span class="text-gray-500 dark:text-gray-400">
                  (
                  {post.data.date.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })}
                  )
                </span>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                  {post.data.description}
                </p>
              </li>
            ))
          }
        </ul>

        {
          pagePosts.length === 0 && (
            <p class="py-8 text-center text-gray-500 dark:text-gray-400">
              No posts match your search.
            </p>
          )
        }

        {
          lastPage > 1 && (
            <>
              <p class="my-4">Page 1 of {lastPage}</p>
              <div class="flex gap-4">
                <a
                  href={pageUrl(2, filters)}
                  class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
                >
                  Next
                </a>
              </div>
            </>
          )
        }
      </section>
    </div>
  </div>
</Layout>
