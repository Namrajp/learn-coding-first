---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <div class="mx-auto mt-20 max-w-[65ch] text-center">
    <h1 class="mb-4 text-6xl font-extrabold text-gray-900 dark:text-gray-100">
      404
    </h1>
    <p class="mb-8 text-xl text-gray-600 dark:text-gray-400">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="rounded-lg bg-[hsl(21,62%,45%)] px-6 py-3 font-medium text-white no-underline hover:bg-[hsl(21,62%,35%)]"
    >
      Go Home
    </a>
  </div>
</Layout>
