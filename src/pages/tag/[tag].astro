---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  let posts = await getCollection("posts");

  posts = posts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
  );

  const tags: string[] = [];
  posts.map((post) => {
    post.data.tags.map((tag) => {
      if (!tags.includes(tag)) tags.push(tag);
    });
  });

  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title="Posts by tag">
  <div class="w-full text-left">
    <h1>Posts by tag</h1>

    <div class="mt-8 grid gap-8 md:grid-cols-[2fr_1fr]">
      <section>
        <p class="my-4 font-semibold">Posts tagged {tag}:</p>

        <ul class="space-y-2">
          {
            posts.map((post) => (
              <li>
                <a class="underline" href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
                <span>({post.data.date.toLocaleDateString()})</span>
              </li>
            ))
          }
        </ul>
      </section>

      <aside class="md:pl-6">
        <p class="my-4 font-semibold">Explore by tag:</p>
        <div class="my-4 flex flex-wrap gap-2">
          {
            posts
              .flatMap((post) => post.data.tags)
              .filter((value, index, self) => self.indexOf(value) === index)
              .map((tagItem) => (
                <a
                  href={`/tag/${tagItem}`}
                  class="py-1 px-2 rounded-lg"
                >
                  {tagItem}
                </a>
              ))
          }
        </div>
      </aside>
    </div>
  </div>
</Layout>
