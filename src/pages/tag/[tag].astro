---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import TagSidebar from "../../components/TagSidebar.astro";
import { formatTagTitle, getTagDescription } from "../../lib/tag-meta";

export const prerender = true;

export async function getStaticPaths() {
  let posts = (await getCollection("posts")).filter(
    (post) => post.data.status !== "draft",
  );

  posts = posts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );

  const tags: string[] = [];
  const tagCounts: Record<string, number> = {};
  posts.map((post) => {
    post.data.tags.map((tag) => {
      if (!tags.includes(tag)) tags.push(tag);
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    });
  });

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((post) => post.data.tags.includes(tag)),
      allTags: tags,
      tagCounts,
      allPosts: posts,
    },
  }));
}

const { tag } = Astro.params;
const { posts, allTags, tagCounts, allPosts } = Astro.props;

const otherTags = allTags
  .filter((t) => t !== tag)
  .sort((a, b) => (tagCounts[b] || 0) - (tagCounts[a] || 0))
  .slice(0, 6);

const otherPostsByTag = otherTags.map((t) => ({
  tag: t,
  posts: allPosts.filter((p) => p.data.tags.includes(t)).slice(0, 3),
}));

const tagTitle = formatTagTitle(tag!);
const tagDescription = getTagDescription(tag!, posts);
const tagUrl = `https://learncodingfirst.com/tag/${tag}`;
---

<Layout
  title={`${tagTitle} Articles`}
  description={tagDescription}
  canonical={tagUrl}
>
  <div class="mx-auto w-full max-w-4xl text-left">
    <div class="mt-8 grid gap-4 md:grid-cols-[250px_1fr] md:gap-8">
      <TagSidebar tags={allTags} {tagCounts} />

      <section>
        <h1
          class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100"
        >
          {tagTitle} articles
        </h1>
        <p class="my-4 text-xl font-semibold dark:text-gray-200">
          {tagDescription}
        </p>

        <ul class="space-y-2">
          {
            posts.map((post) => (
              <li>
                <a
                  href={`/${post.id}`}
                  class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4"
                >
                  {post.data.title}
                </a>
                <span>({post.data.date.toLocaleDateString()})</span>
              </li>
            ))
          }
        </ul>

        {
          otherPostsByTag.length > 0 && (
            <div class="mt-12">
              <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-gray-100">
                Other posts you may be interested in
              </h2>
              {otherPostsByTag.map((group) => (
                <div class="mb-6">
                  <h3 class="mb-2 text-lg font-semibold text-gray-700 dark:text-gray-300">
                    Posts tagged "{group.tag}"
                  </h3>
                  <ul class="space-y-1">
                    {group.posts.map((post) => (
                      <li>
                        <a
                          href={`/${post.id}`}
                          class="text-[hsl(21,62%,45%)] hover:text-[hsl(21,62%,35%)]"
                        >
                          {post.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )
        }
      </section>
    </div>
  </div>
</Layout>
