---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import TagSidebar from "../../components/TagSidebar.astro";

export const prerender = true;

export async function getStaticPaths() {
  let posts = await getCollection("posts");

  posts = posts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );

  const tags: string[] = [];
  posts.map((post) => {
    post.data.tags.map((tag) => {
      if (!tags.includes(tag)) tags.push(tag);
    });
  });

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((post) => post.data.tags.includes(tag)),
      allTags: tags,
      allPosts: posts,
    },
  }));
}

const { tag } = Astro.params;
const { posts, allTags, allPosts } = Astro.props;

const otherTags = allTags
  .filter((t) => t !== tag)
  .sort(() => 0.5 - Math.random())
  .slice(0, 6);

const otherPostsByTag = otherTags.map((t) => ({
  tag: t,
  posts: allPosts.filter((p) => p.data.tags.includes(t)).slice(0, 3),
}));
---

<Layout title={`Posts by tag: ${tag}`}>
  <div class="mx-auto w-full max-w-[90vw] text-left">
    <div class="mt-8 grid gap-8 md:grid-cols-[30%_70%]">
      <TagSidebar tags={allTags} />

      <section>
        <h1 class="mb-4 text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">
          Posts tagged {tag}
        </h1>
        <p class="my-4 text-xl font-semibold dark:text-gray-200">Latest posts for this topic</p>

        <ul class="space-y-2">
          {
            posts.map((post) => (
              <li>
                <a
                  href={`/${post.id}`}
                  class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4"
                >
                  {post.data.title}
                </a>
                <span>({post.data.date.toLocaleDateString()})</span>
              </li>
            ))
          }
        </ul>

        {otherPostsByTag.length > 0 && (
          <div class="mt-12">
            <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-gray-100">Other posts you may be interested in</h2>
            {otherPostsByTag.map((group) => (
              <div class="mb-6">
                <h3 class="mb-2 text-lg font-semibold text-gray-700 dark:text-gray-300">
                  Posts tagged "{group.tag}"
                </h3>
                <ul class="space-y-1">
                  {group.posts.map((post) => (
                    <li>
                      <a
                        href={`/${post.id}`}
                        class="text-[hsl(21,62%,45%)] hover:text-[hsl(21,62%,35%)]"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</Layout>
