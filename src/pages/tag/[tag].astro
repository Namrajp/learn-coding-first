---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import TagSidebar from "../../components/TagSidebar.astro";

export const prerender = true;

export async function getStaticPaths() {
  let posts = await getCollection("posts");

  posts = posts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );

  const tags: string[] = [];
  posts.map((post) => {
    post.data.tags.map((tag) => {
      if (!tags.includes(tag)) tags.push(tag);
    });
  });

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((post) => post.data.tags.includes(tag)),
      allTags: tags,
    },
  }));
}

const { tag } = Astro.params;
const { posts, allTags } = Astro.props;
---

<Layout title={`Posts by tag: ${tag}`}>
  <div class="mx-auto w-full max-w-[90vw] text-left">
    <div class="mt-8 grid gap-8 md:grid-cols-[30%_70%]">
      <TagSidebar tags={allTags} />

      <section>
        <h1 class="mb-4 text-5xl font-extrabold tracking-tight text-slate-900">
          Posts tagged {tag}
        </h1>
        <p class="my-4 text-xl font-semibold">Latest posts for this topic</p>

        <ul class="space-y-2">
          {
            posts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4"
                >
                  {post.data.title}
                </a>
                <span>({post.data.date.toLocaleDateString()})</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Layout>
