---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
let posts = await getCollection("posts");

posts = posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);

const allPosts = await getCollection("posts");
const randomPost = allPosts[Math.floor(Math.random() * allPosts.length)];
const promptingPost = allPosts.find((p) => p.id === "prompting-guide");
const claudePost = allPosts.find((p) => p.id === "claude-guide");

const featuredIds = new Set(
  [promptingPost?.id, claudePost?.id, randomPost?.id].filter(Boolean),
);
const otherPosts = allPosts
  .filter((p) => !featuredIds.has(p.id))
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .slice(0, 2);

const tagCounts: Record<string, number> = {};
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const sortedTags = Object.entries(tagCounts)
  .sort(([, a], [, b]) => b - a)
  .map(([tag]) => tag);
---

<Layout
  title="Learn Coding First — Programming & AI Tutorials"
  pageType="website"
  showNav={false}
>
  <div class="w-full -mt-8">
    <div
      class="fixed top-0 right-0 left-0 z-50 flex items-center justify-center bg-[hsl(21,62%,45%)] px-4 pt-3 pb-[1.25rem] text-center text-white shadow-sm sm:px-8"
    >
      <p class="text-sm leading-tight font-semibold sm:text-base">
        Coming Soon: AI Workshop and new content releasing every week.
      </p>
    </div>

    <section class="mt-24 min-h-[70vh] flex flex-col items-center justify-center text-center">
      <h1
        class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100"
      >
        Fundamentals of programming and using AI
      </h1>

      <p class="mx-auto mb-6 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Tutorials, guides, and resources to help you learn coding from scratch and harness the power of artificial intelligence.
      </p>

      <ul class="mx-auto max-w-2xl list-none space-y-2 pl-12 text-left sm:pl-16">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/${post.id}`}
                class="no-underline hover:text-[hsl(21,62%,45%)] hover:underline-offset-4"
              >
                {post.data.title}
              </a>
              <span class="ml-3 text-sm text-slate-500">
                ({post.data.date.toLocaleDateString()})
              </span>
            </li>
          ))
        }
      </ul>

      <p class="py-4">
        <a href={"/blog/page/1"}> See all posts ▶︎ </a>
      </p>
    </section>

    <section class="mt-16 text-center">
      <div class="mx-auto mb-8 flex max-w-2xl flex-wrap justify-center gap-2">
        {
          sortedTags.map((tag) => (
            <a
              href={`/tag/${tag}`}
              class="rounded-sm bg-gray-100 px-4 py-2 text-sm font-medium capitalize text-gray-700 no-underline hover:bg-[hsl(21,62%,45%)] hover:text-white dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-[hsl(21,62%,45%)]"
            >
              {tag}
            </a>
          ))
        }
      </div>

      <h2
        class="mb-8 text-4xl font-extrabold tracking-tight text-slate-900"
      >
        What's New
      </h2>
      <div class="mx-auto max-w-2xl text-left">
        {
          promptingPost && (
            <PostCard
              date={promptingPost.data.date.toLocaleDateString()}
              title={promptingPost.data.title}
              excerpt="Prompting is the art of giving AI clear, well-structured instructions to get the output you actually want. Learn how to be specific, give the AI a role, provide context, use step-by-step instructions, iterate and refine, and show examples to dramatically improve your results."
              link={`/${promptingPost.id}`}
            />
          )
        }
        {
          claudePost && (
            <PostCard
              date={claudePost.data.date.toLocaleDateString()}
              title={claudePost.data.title}
              excerpt="Claude is Anthropic's AI assistant, built with a strong emphasis on being helpful, harmless, and honest. It excels at long-form reasoning, nuanced writing, and following complex multi-step instructions — but like any tool, it rewards users who understand how it thinks."
              link={`/${claudePost.id}`}
            />
          )
        }
        <PostCard
          date={randomPost.data.date.toLocaleDateString()}
          title={randomPost.data.title}
          excerpt={randomPost.data.description || "Check out this post!"}
          link={`/${randomPost.id}`}
        />
        {
          otherPosts.map((post) => (
            <PostCard
              date={post.data.date.toLocaleDateString()}
              title={post.data.title}
              excerpt={post.data.description || "Check out this post!"}
              link={`/${post.id}`}
            />
          ))
        }
      </div>
    </section>
  </div>
</Layout>
