---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Pricing">
  <div class="space-y-12 sm:grid sm:grid-cols-2 sm:space-y-0 sm:gap-x-8">
    <div
      class="flex flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-sm"
    >
      <h3 class="text-3xl font-semibold text-gray-900">Basic</h3>

      <p class="mx-auto mt-4">
        <span class="text-5xl font-extrabold tracking-tight">$29</span>
        <span class="ml-1 text-xl font-semibold">/month</span>
      </p>
      <p class="mt-6 text-gray-500">The essentials</p>

      <ul role="list" class="mt-6 space-y-6">
        <li class="flex">
          <span class="-mt-2 text-3xl text-blue-500">&check;</span>
          <span class="ml-3 text-left text-gray-500">Access to our service</span
          >
        </li>

        <li class="flex">
          <span class="-mt-2 text-3xl text-blue-500">&check;</span>
          <span class="ml-3 text-left text-gray-500">Support</span>
        </li>
      </ul>
    </div>

    <div
      class="flex flex-col rounded-2xl border border-gray-200 bg-white p-8 shadow-sm"
    >
      <h3 class="text-3xl font-semibold text-gray-900">Pro</h3>

      <p class="mx-auto mt-4">
        <span class="text-5xl font-extrabold tracking-tight">$99</span>
        <span class="ml-1 text-xl font-semibold">/month</span>
      </p>
      <p class="mt-6 text-gray-500">Much more features</p>

      <ul role="list" class="mt-6 space-y-6">
        <li class="flex">
          <span class="-mt-2 text-3xl text-blue-500">&check;</span>
          <span class="ml-3 text-gray-500">Access to our service</span>
        </li>

        <li class="flex">
          <span class="-mt-2 text-3xl text-blue-500">&check;</span>
          <span class="ml-3 text-left text-gray-500">Support</span>
        </li>

        <li class="flex">
          <span class="-mt-2 text-3xl text-blue-500">&check;</span>
          <span class="ml-3 text-left text-gray-500">More features</span>
        </li>
      </ul>
    </div>
  </div>
  <a
    href="#"
    class="mt-8 block w-full rounded-md border border-transparent bg-blue-500 px-6 py-3 text-center text-xl font-medium text-white hover:bg-blue-600"
    >Sign up</a
  >
</Layout>
