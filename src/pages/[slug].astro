---
import { marked } from "marked";
import Layout from "@layouts/Layout.astro";
import { parseFrontmatter } from "../lib/frontmatter";

const slug = Astro.params.slug;
if (!slug) {
  return Astro.redirect("/");
}

const env = Astro.locals.env;
if (!env?.GITHUB_TOKEN) {
  return Astro.redirect("/");
}

let post: { title: string; date: string; tags: string[]; description: string; status: string; content: string } | null = null;

try {
  const filePath = `src/posts/${slug}.md`;
  const apiUrl = `https://api.github.com/repos/Namrajp/my-new-astro-blog/contents/${filePath}`;
  const res = await fetch(apiUrl, {
    headers: {
      Authorization: `Bearer ${env.GITHUB_TOKEN}`,
      Accept: "application/vnd.github+json",
      "X-GitHub-Api-Version": "2022-11-28",
      "User-Agent": "learncodingfirst-blog",
    },
  });

  if (!res.ok) {
    return Astro.redirect("/");
  }

  const data = (await res.json()) as { content: string; encoding: string };
  const raw = decodeURIComponent(
    atob(data.content)
      .split("")
      .map((c) => "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2))
      .join(""),
  );

  const fmMatch = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (!fmMatch) {
    return Astro.redirect("/");
  }

  const fm = parseFrontmatter(raw);
  if (!fm) {
    return Astro.redirect("/");
  }

  if (fm.status === "draft") {
    return Astro.redirect("/");
  }

  post = {
    title: fm.title || slug,
    date: fm.date,
    tags: fm.tags,
    description: fm.description,
    status: fm.status,
    content: fmMatch[2],
  };
} catch {
  return Astro.redirect("/");
}

if (!post) {
  return Astro.redirect("/");
}

const htmlContent = marked.parse(post.content) as string;
const postDate = new Date(post.date);
---

<Layout frontmatter={{ title: post.title, description: post.description, date: postDate, tags: post.tags }} title={post.title} tags={post.tags}>
  <div class="mx-auto max-w-[65ch]">
    <h1 class="mt-8 mb-2 text-3xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100">
      {post.title}
    </h1>
    <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">Namraj Pudasaini</p>
    <p class="mb-6 text-sm text-gray-500 dark:text-gray-400">
      {postDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
    </p>
    <div class="prose dark:prose-invert">
      <Fragment set:html={htmlContent} />
    </div>
    <div class="my-4 space-x-2">
      {
        post.tags.map((tag) => (
          <a
            href={`/tag/${tag}`}
            class="rounded-lg px-2 py-1 no-underline text-gray-700 dark:text-gray-300 hover:text-[hsl(21,62%,45%)]"
          >
            {tag}
          </a>
        ))
      }
    </div>
  </div>
</Layout>
