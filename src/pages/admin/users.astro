---
import Layout from "../../layouts/Layout.astro";
import { getAuthorizedUsers } from "../../lib/auth-config";

const user = Astro.locals.user;
const env = Astro.locals.env;

if (!user || user.role !== "admin") {
  return Astro.redirect("/admin");
}

let authorizedUsers: { email: string; role: string }[] = [];
try {
  authorizedUsers = await getAuthorizedUsers(env);
} catch {
  authorizedUsers = [];
}
---

<Layout title="Manage Users" showSignOut={true}>
  <div class="mx-auto mt-10 max-w-4xl">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold dark:text-white">Manage Users</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">
          Add or remove authorized users
        </p>
      </div>
      <a
        href="/admin"
        class="text-gray-600 no-underline hover:text-[hsl(21,62%,45%)] dark:text-gray-400"
      >
        Back to Dashboard
      </a>
    </div>

    <div
      class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800"
    >
      <h2 class="mb-4 text-xl font-semibold dark:text-white">
        Authorized Users ({authorizedUsers.length})
      </h2>

      <div class="mb-6">
        <form id="add-user-form" class="flex gap-4">
          <input
            type="email"
            id="new-email"
            placeholder="user@example.com"
            required
            class="flex-1 rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
          />
          <select
            id="new-role"
            class="rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
          >
            <option value="editor">Editor</option>
            <option value="admin">Admin</option>
          </select>
          <button
            type="submit"
            class="rounded-lg bg-[hsl(21,62%,45%)] px-6 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
          >
            Add User
          </button>
        </form>
        <div id="add-message" class="mt-2 hidden"></div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th
                class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300"
                >Email</th
              >
              <th
                class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300"
                >Role</th
              >
              <th
                class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300"
                >Actions</th
              >
            </tr>
          </thead>
          <tbody>
            {
              authorizedUsers.map((u) => (
                <tr class="border-b border-gray-100 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-700">
                  <td class="px-4 py-3">{u.email}</td>
                  <td class="px-4 py-3">
                    <span
                      class={`rounded px-2 py-1 text-xs font-medium ${u.role === "admin" ? "bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300" : "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300"}`}
                    >
                      {u.role}
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <button
                      class="remove-btn text-sm text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                      data-email={u.email}
                    >
                      Remove
                    </button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const addForm = document.getElementById(
      "add-user-form",
    ) as HTMLFormElement;
    const addMessage = document.getElementById("add-message") as HTMLDivElement;

    addForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (
        document.getElementById("new-email") as HTMLInputElement
      ).value.trim();
      const role = (document.getElementById("new-role") as HTMLSelectElement)
        .value;

      addMessage.className = "mt-2 hidden";

      const res = await fetch("/api/admin/users", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, role }),
      });

      if (res.ok) {
        addMessage.textContent = "User added successfully";
        addMessage.className = "mt-2 text-green-600";
        setTimeout(() => window.location.reload(), 1000);
      } else {
        const data = await res.json();
        addMessage.textContent = data.error || "Failed to add user";
        addMessage.className = "mt-2 text-red-600";
      }
    });

    document.querySelectorAll(".remove-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const email = (btn as HTMLElement).dataset.email;
        if (!confirm(`Remove ${email}?`)) return;

        const res = await fetch("/api/admin/users", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(`Failed to remove user: ${data.error}`);
        }
      });
    });
  </script>
</Layout>
