---
import Layout from "../../layouts/Layout.astro";
import { listContacts } from "../../lib/newsletter";

const env = Astro.locals.env;
const contacts = await listContacts(env);
const active = contacts.filter((c) => !c.unsubscribed);
const unsubscribed = contacts.filter((c) => c.unsubscribed);
---

<Layout title="Newsletter Subscribers" showSignOut={true}>
  <div class="mx-auto mt-10 max-w-4xl">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold dark:text-white">
          Newsletter Subscribers
        </h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">
          {active.length} active subscriber{active.length !== 1 ? "s" : ""}
          {unsubscribed.length > 0 && ` · ${unsubscribed.length} unsubscribed`}
        </p>
      </div>
      <a
        href="/admin"
        class="rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
      >
        Back to Dashboard
      </a>
    </div>

    <div
      class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800"
    >
      <h2 class="mb-4 text-xl font-semibold dark:text-white">
        Active ({active.length})
      </h2>

      {
        active.length === 0 ? (
          <p class="text-gray-500 dark:text-gray-400">No subscribers yet.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700">
                  <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">
                    Email
                  </th>
                  <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">
                    Name
                  </th>
                  <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">
                    Subscribed
                  </th>
                  <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300" />
                </tr>
              </thead>
              <tbody>
                {active.map((contact) => (
                  <tr class="border-b border-gray-100 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-700">
                    <td class="px-4 py-3 text-sm dark:text-gray-300">
                      {contact.email}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                      {contact.name || "—"}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                      {new Date(contact.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                    </td>
                    <td class="px-4 py-3">
                      <button
                        class="delete-btn text-sm text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                        data-email={contact.email}
                      >
                        Remove
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    {
      unsubscribed.length > 0 && (
        <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800">
          <h2 class="mb-4 text-xl font-semibold dark:text-white">
            Unsubscribed ({unsubscribed.length})
          </h2>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700">
                  <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">
                    Email
                  </th>
                  <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">
                    Name
                  </th>
                  <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300" />
                </tr>
              </thead>
              <tbody>
                {unsubscribed.map((contact) => (
                  <tr class="border-b border-gray-100 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-700">
                    <td class="px-4 py-3 text-sm dark:text-gray-300">
                      {contact.email}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                      {contact.name || "—"}
                    </td>
                    <td class="px-4 py-3">
                      <button
                        class="delete-btn text-sm text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                        data-email={contact.email}
                      >
                        Remove
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }
  </div>

  <script>
    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const email = (btn as HTMLElement).dataset.email;
        if (!confirm(`Remove "${email}" from the newsletter?`)) return;

        const res = await fetch("/api/newsletter/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(`Delete failed: ${data.error}`);
        }
      });
    });
  </script>
</Layout>
