---
import Layout from "../../layouts/Layout.astro";
import { listFiles } from "../../lib/github";
import { parseFrontmatter } from "../../lib/frontmatter";

const user = Astro.locals.user;
const env = Astro.locals.env;

let posts: { slug: string; title: string; date: string; tags: string[]; status: string }[] = [];
try {
  if (env.GITHUB_TOKEN) {
    const files = await listFiles(
      { token: env.GITHUB_TOKEN, owner: "Namrajp", repo: "my-new-astro-blog" },
      "src/posts",
    );

    for (const file of files) {
      const url = `https://raw.githubusercontent.com/Namrajp/my-new-astro-blog/main/${file.path}`;
      const res = await fetch(url, {
        headers: { Authorization: `Bearer ${env.GITHUB_TOKEN}`, "User-Agent": "learncodingfirst-blog" },
      });
      if (!res.ok) continue;

      const content = await res.text();
      const fm = parseFrontmatter(content);
      if (!fm) continue;

      posts.push({
        slug: file.name.replace(/\.md$/, ""),
        title: fm.title || file.name,
        date: fm.date,
        tags: fm.tags,
        status: fm.status,
      });
    }

    posts.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
  }
} catch {
  posts = [];
}
---

<Layout title="Admin Dashboard">
  <div class="mx-auto mt-10 max-w-4xl">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold dark:text-white">Admin Dashboard</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">
          Welcome back, {user?.email}
        </p>
      </div>
      <a
        href="/admin/new"
        class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
      >
        New Post
      </a>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800">
      <h2 class="mb-4 text-xl font-semibold dark:text-white">
        All Posts ({posts.length})
      </h2>

      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">Title</th>
              <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">Date</th>
              <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">Tags</th>
              <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">Status</th>
              <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">Actions</th>
            </tr>
          </thead>
          <tbody>
            {
              posts.map((post) => (
                <tr class="border-b border-gray-100 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-700">
                  <td class="px-4 py-3">
                    <a
                      href={`/${post.slug}`}
                      class="text-[hsl(21,62%,45%)] hover:underline"
                      target="_blank"
                    >
                      {post.title}
                    </a>
                  </td>
                  <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                    {post.date}
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-1">
                      {post.tags.slice(0, 3).map((tag) => (
                        <span class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                          {tag}
                        </span>
                      ))}
                      {post.tags.length > 3 && (
                        <span class="px-2 py-1 text-xs text-gray-400">
                          +{post.tags.length - 3}
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <span
                      class={`rounded px-2 py-1 text-xs font-medium ${post.status === "published" ? "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300" : "bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300"}`}
                    >
                      {post.status}
                    </span>
                  </td>
                  <td class="px-4 py-3 flex gap-3">
                    <a
                      href={`/admin/edit/${post.slug}`}
                      class="text-sm text-gray-600 hover:text-[hsl(21,62%,45%)] dark:text-gray-400"
                    >
                      Edit
                    </a>
                    <button
                      class="delete-btn text-sm text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                      data-slug={post.slug}
                      data-title={post.title}
                    >
                      Delete
                    </button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-8 text-center">
      <button
        id="logout-btn"
        class="rounded-lg border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
      >
        Sign Out
      </button>
    </div>
  </div>

  <script>
    import { authClient } from "../../lib/auth-client";

    document
      .getElementById("logout-btn")
      ?.addEventListener("click", async () => {
        await authClient.signOut();
        window.location.href = "/login";
      });

    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const slug = (btn as HTMLElement).dataset.slug;
        const title = (btn as HTMLElement).dataset.title;
        if (!confirm(`Delete "${title}"? This will remove the post from your repo.`)) return;

        const res = await fetch("/api/posts/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slug }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(`Delete failed: ${data.error}`);
        }
      });
    });
  </script>
</Layout>
