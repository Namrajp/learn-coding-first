---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const user = Astro.locals.user;

const posts = await getCollection("posts");
const sortedPosts = posts
  .sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  )
  .map((post) => ({
    ...post,
    status: post.data.status || "published",
  }));
---

<Layout title="Admin Dashboard">
  <div class="mx-auto mt-10 max-w-4xl">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold">Admin Dashboard</h1>
        <p class="mt-1 text-gray-500">
          Welcome back, {user?.email}
        </p>
      </div>
      <a
        href="/admin/new"
        class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
      >
        New Post
      </a>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-6">
      <h2 class="mb-4 text-xl font-semibold">
        All Posts ({sortedPosts.length})
      </h2>

      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="px-4 py-3 font-medium text-gray-700">Title</th>
              <th class="px-4 py-3 font-medium text-gray-700">Date</th>
              <th class="px-4 py-3 font-medium text-gray-700">Tags</th>
              <th class="px-4 py-3 font-medium text-gray-700">Status</th>
              <th class="px-4 py-3 font-medium text-gray-700">Actions</th>
            </tr>
          </thead>
          <tbody>
            {
              sortedPosts.map((post) => (
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                  <td class="px-4 py-3">
                    <a
                      href={`/blog/${post.id}`}
                      class="text-[hsl(21,62%,45%)] hover:underline"
                      target="_blank"
                    >
                      {post.data.title}
                    </a>
                  </td>
                  <td class="px-4 py-3 text-sm text-gray-500">
                    {post.data.date.toLocaleDateString()}
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex flex-wrap gap-1">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600">
                          {tag}
                        </span>
                      ))}
                      {post.data.tags.length > 3 && (
                        <span class="px-2 py-1 text-xs text-gray-400">
                          +{post.data.tags.length - 3}
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <span
                      class={`rounded px-2 py-1 text-xs font-medium ${post.status === "published" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700"}`}
                    >
                      {post.status}
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <a
                      href={`/admin/edit/${post.id}`}
                      class="text-sm text-gray-600 hover:text-[hsl(21,62%,45%)]"
                    >
                      Edit
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-8 text-center">
      <button
        id="logout-btn"
        class="rounded-lg border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-50"
      >
        Sign Out
      </button>
    </div>
  </div>

  <script>
    import { authClient } from "../../lib/auth-client";

    document
      .getElementById("logout-btn")
      ?.addEventListener("click", async () => {
        await authClient.signOut();
        window.location.href = "/login";
      });
  </script>
</Layout>
