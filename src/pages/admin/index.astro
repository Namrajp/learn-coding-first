---
import Layout from "../../layouts/Layout.astro";
import { listFiles } from "../../lib/github";
import { parseFrontmatter } from "../../lib/frontmatter";
import { getAuthorizedUsers } from "../../lib/auth-config";

const user = Astro.locals.user;
const env = Astro.locals.env;
const isAdmin = user?.role === "admin";

function decodeGitHubContent(encoded: string): string {
  return decodeURIComponent(
    atob(encoded)
      .split("")
      .map((c) => "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2))
      .join(""),
  );
}

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
}

function getMonthYear(dateStr: string): string {
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return "";
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${months[d.getMonth()]} ${d.getFullYear()}`;
}

let posts: {
  slug: string;
  title: string;
  date: string;
  tags: string[];
  status: string;
}[] = [];
try {
  if (env.GITHUB_TOKEN) {
    const files = await listFiles(
      { token: env.GITHUB_TOKEN, owner: "Namrajp", repo: "my-new-astro-blog" },
      "src/posts",
    );

    const results = await Promise.allSettled(
      files.map(async (file) => {
        const url = `https://api.github.com/repos/Namrajp/my-new-astro-blog/contents/${file.path}`;
        const res = await fetch(url, {
          headers: {
            Authorization: `Bearer ${env.GITHUB_TOKEN}`,
            Accept: "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "learncodingfirst-blog",
          },
        });
        if (!res.ok) return null;

        const json = (await res.json()) as {
          content: string;
          encoding: string;
        };
        const content = decodeGitHubContent(json.content);
        const fm = parseFrontmatter(content);
        if (!fm) return null;

        return {
          slug: file.name.replace(/\.md$/, ""),
          title: fm.title || file.name,
          date: fm.date,
          tags: fm.tags,
          status: fm.status,
        };
      }),
    );

    posts = results
      .filter(
        (
          r,
        ): r is PromiseFulfilledResult<{
          slug: string;
          title: string;
          date: string;
          tags: string[];
          status: string;
        } | null> => r.status === "fulfilled" && r.value !== null,
      )
      .map((r) => r.value!);

    posts.sort(
      (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf(),
    );
  }
} catch {
  posts = [];
}

const allTags = [...new Set(posts.flatMap((p) => p.tags))].sort();
const allMonths = [...new Set(posts.map((p) => getMonthYear(p.date)).filter(Boolean))].sort((a, b) => {
  const da = new Date(a);
  const db = new Date(b);
  return db.valueOf() - da.valueOf();
});

let authorizedUsers: { email: string; role: string }[] = [];
if (isAdmin) {
  try {
    authorizedUsers = await getAuthorizedUsers(env);
  } catch {
    authorizedUsers = [];
  }
}
---

<Layout title="Admin Dashboard" showSignOut={true}>
  <div class="mx-auto mt-6 max-w-4xl px-4 sm:mt-10 sm:px-6">
    <div class="mb-6 flex flex-col gap-4 sm:mb-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold dark:text-white sm:text-3xl">Admin Dashboard</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400 sm:text-base">
          Welcome back, {user?.email}
          <span class={`ml-2 rounded px-2 py-1 text-xs font-medium ${isAdmin ? "bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300" : "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300"}`}>
            {isAdmin ? "Admin" : "Editor"}
          </span>
        </p>
      </div>
      <div class="flex gap-3">
        <a
          href="/admin/newsletter"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700 sm:text-base"
        >
          Newsletter
        </a>
        <a
          href="/admin/new"
          class="rounded-lg bg-[hsl(21,62%,45%)] px-4 py-2 text-sm font-medium text-white hover:bg-[hsl(21,62%,35%)] sm:text-base"
        >
          New Post
        </a>
      </div>
    </div>

    <div
      class="rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800 sm:p-6"
    >
      <h2 class="mb-4 text-lg font-semibold dark:text-white sm:text-xl">
        All Posts (<span id="visible-count">{posts.length}</span>/{posts.length})
      </h2>

      <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            type="text"
            id="filter-search"
            placeholder="Search by title or tag..."
            class="w-full rounded-lg border border-gray-300 bg-white py-2 pl-9 pr-4 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white dark:focus:ring-[hsl(21,62%,45%)]"
          />
        </div>
        <select
          id="filter-status"
          class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white"
        >
          <option value="">All Status</option>
          <option value="published">Published</option>
          <option value="draft">Draft</option>
        </select>
        <select
          id="filter-month"
          class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white"
        >
          <option value="">All Months</option>
          {allMonths.map((m) => <option value={m}>{m}</option>)}
        </select>
        <select
          id="filter-tag"
          class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-900 dark:text-white"
        >
          <option value="">All Tags</option>
          {allTags.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th class="hidden px-4 py-3 font-medium text-gray-700 dark:text-gray-300 sm:table-cell"
                >Title</th
              >
              <th class="hidden px-4 py-3 font-medium text-gray-700 dark:text-gray-300 sm:table-cell"
                >Date</th
              >
              <th class="hidden px-4 py-3 font-medium text-gray-700 dark:text-gray-300 md:table-cell"
                >Tags</th
              >
              <th class="hidden px-4 py-3 font-medium text-gray-700 dark:text-gray-300 sm:table-cell"
                >Status</th
              >
              <th class="hidden px-4 py-3 font-medium text-gray-700 dark:text-gray-300 sm:table-cell"
                >Actions</th
              >
            </tr>
          </thead>
          <tbody id="posts-body">
            {
              posts.map((post) => (
                <tr
                  class="post-row border-b border-gray-100 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-700"
                  data-title={post.title.toLowerCase()}
                  data-tags={post.tags.join(" ").toLowerCase()}
                  data-status={post.status}
                  data-month={getMonthYear(post.date)}
                  data-date={post.date}
                >
                  <td class="px-4 py-3 sm:table-cell" colspan="1">
                    <div class="flex flex-col gap-1 sm:block">
                      <a
                        href={
                          post.status === "draft"
                            ? `/admin/preview/${post.slug}`
                            : `/${post.slug}`
                        }
                        class="text-sm font-medium text-[hsl(21,62%,45%)] hover:text-[hsl(21,62%,35%)] sm:text-base"
                        target="_blank"
                      >
                        {post.title}
                      </a>
                      <div class="flex items-center gap-2 sm:hidden">
                        <span class="text-xs text-gray-500 dark:text-gray-400">{formatDate(post.date)}</span>
                        <span
                          class={`rounded px-1.5 py-0.5 text-[10px] font-medium ${post.status === "published" ? "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300" : "bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300"}`}
                        >
                          {post.status}
                        </span>
                      </div>
                      <div class="flex flex-wrap gap-1 sm:hidden">
                        {post.tags.slice(0, 2).map((tag) => (
                          <span class="rounded bg-gray-100 px-1.5 py-0.5 text-[10px] text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                            {tag}
                          </span>
                        ))}
                        {post.tags.length > 2 && (
                          <span class="px-1 py-0.5 text-[10px] text-gray-400">
                            +{post.tags.length - 2}
                          </span>
                        )}
                      </div>
                    </div>
                  </td>
                  <td class="hidden px-4 py-3 text-sm text-gray-500 dark:text-gray-400 sm:table-cell">
                    {formatDate(post.date)}
                  </td>
                  <td class="hidden px-4 py-3 md:table-cell">
                    <div class="flex flex-wrap gap-1">
                      {post.tags.slice(0, 3).map((tag) => (
                        <span class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                          {tag}
                        </span>
                      ))}
                      {post.tags.length > 3 && (
                        <span class="px-2 py-1 text-xs text-gray-400">
                          +{post.tags.length - 3}
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="hidden px-4 py-3 sm:table-cell">
                    <span
                      class={`rounded px-2 py-1 text-xs font-medium ${post.status === "published" ? "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300" : "bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300"}`}
                    >
                      {post.status}
                    </span>
                  </td>
                  <td class="hidden px-4 py-3 sm:table-cell">
                    <div class="flex gap-3">
                      <a
                        href={`/admin/edit/${post.slug}`}
                        class="text-sm text-gray-600 hover:text-[hsl(21,62%,45%)] dark:text-gray-400"
                      >
                        Edit
                      </a>
                      {isAdmin && (
                        <button
                          class="delete-btn text-sm text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                          data-slug={post.slug}
                          data-title={post.title}
                        >
                          Delete
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p id="no-results" class="hidden py-8 text-center text-gray-500 dark:text-gray-400">No posts match the current filters.</p>
      </div>
    </div>

    {isAdmin && (
      <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800 sm:p-6">
        <h2 class="mb-4 text-lg font-semibold dark:text-white sm:text-xl">
          Manage Users ({authorizedUsers.length})
        </h2>

        <div class="mb-6">
          <form id="add-user-form" class="flex flex-col gap-3 sm:flex-row">
            <input
              type="email"
              id="new-email"
              placeholder="user@example.com"
              required
              class="flex-1 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white sm:text-base"
            />
            <select
              id="new-role"
              class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white sm:text-base"
            >
              <option value="editor">Editor</option>
              <option value="admin">Admin</option>
            </select>
            <button
              type="submit"
              class="rounded-lg bg-[hsl(21,62%,45%)] px-6 py-2 text-sm font-medium text-white hover:bg-[hsl(21,62%,35%)] sm:text-base"
            >
              Add User
            </button>
          </form>
          <div id="add-message" class="mt-2 hidden"></div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-700">
                <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">Email</th>
                <th class="hidden px-4 py-3 font-medium text-gray-700 dark:text-gray-300 sm:table-cell">Role</th>
                <th class="px-4 py-3 font-medium text-gray-700 dark:text-gray-300">Actions</th>
              </tr>
            </thead>
            <tbody>
              {authorizedUsers.map((u) => (
                <tr class="border-b border-gray-100 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-700">
                  <td class="px-4 py-3 text-sm">
                    {u.email}
                    <span class="ml-1 inline-block sm:hidden">
                      <span class={`rounded px-1.5 py-0.5 text-[10px] font-medium ${u.role === "admin" ? "bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300" : "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300"}`}>
                        {u.role}
                      </span>
                    </span>
                  </td>
                  <td class="hidden px-4 py-3 sm:table-cell">
                    <span class={`rounded px-2 py-1 text-xs font-medium ${u.role === "admin" ? "bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300" : "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300"}`}>
                      {u.role}
                    </span>
                  </td>
                  <td class="px-4 py-3">
                    <button
                      class="remove-user-btn text-sm text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300"
                      data-email={u.email}
                    >
                      Remove
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>

  <script>
    function initFilters() {
      const searchInput = document.getElementById("filter-search") as HTMLInputElement;
      const statusSelect = document.getElementById("filter-status") as HTMLSelectElement;
      const monthSelect = document.getElementById("filter-month") as HTMLSelectElement;
      const tagSelect = document.getElementById("filter-tag") as HTMLSelectElement;
      const rows = document.querySelectorAll<HTMLElement>(".post-row");
      const visibleCount = document.getElementById("visible-count");
      const noResults = document.getElementById("no-results");

      function applyFilters() {
        const search = searchInput?.value.toLowerCase() || "";
        const status = statusSelect?.value || "";
        const month = monthSelect?.value || "";
        const tag = tagSelect?.value || "";
        let visible = 0;

        rows.forEach((row) => {
          const title = row.dataset.title || "";
          const tags = row.dataset.tags || "";
          const rowStatus = row.dataset.status || "";
          const rowMonth = row.dataset.month || "";

          const matchSearch = !search || title.includes(search) || tags.includes(search);
          const matchStatus = !status || rowStatus === status;
          const matchMonth = !month || rowMonth === month;
          const matchTag = !tag || tags.includes(tag.toLowerCase());

          if (matchSearch && matchStatus && matchMonth && matchTag) {
            row.style.display = "";
            visible++;
          } else {
            row.style.display = "none";
          }
        });

        if (visibleCount) visibleCount.textContent = String(visible);
        if (noResults) noResults.classList.toggle("hidden", visible > 0);
      }

      searchInput?.addEventListener("input", applyFilters);
      statusSelect?.addEventListener("change", applyFilters);
      monthSelect?.addEventListener("change", applyFilters);
      tagSelect?.addEventListener("change", applyFilters);
    }

    initFilters();

    const addForm = document.getElementById("add-user-form") as HTMLFormElement;
    const addMessage = document.getElementById("add-message") as HTMLDivElement;

    addForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (document.getElementById("new-email") as HTMLInputElement).value.trim();
      const role = (document.getElementById("new-role") as HTMLSelectElement).value;

      addMessage.className = "mt-2 hidden";

      const res = await fetch("/api/admin/users", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, role }),
      });

      if (res.ok) {
        addMessage.textContent = "User added successfully";
        addMessage.className = "mt-2 text-green-600";
        setTimeout(() => window.location.reload(), 1000);
      } else {
        const data = await res.json();
        addMessage.textContent = data.error || "Failed to add user";
        addMessage.className = "mt-2 text-red-600";
      }
    });

    document.querySelectorAll(".remove-user-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const email = (btn as HTMLElement).dataset.email;
        if (!confirm(`Remove ${email}?`)) return;

        const res = await fetch("/api/admin/users", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(`Failed to remove user: ${data.error}`);
        }
      });
    });

    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const slug = (btn as HTMLElement).dataset.slug;
        const title = (btn as HTMLElement).dataset.title;
        if (
          !confirm(
            `Delete "${title}"? This will remove the post from your repo.`,
          )
        )
          return;

        const res = await fetch("/api/posts/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slug }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert(`Delete failed: ${data.error}`);
        }
      });
    });
  </script>
</Layout>
