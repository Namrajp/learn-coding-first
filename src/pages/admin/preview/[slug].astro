---
import Layout from "../../../layouts/Layout.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import { parsePostFile } from "../../../lib/frontmatter";
import { renderMarkdown } from "../../../lib/markdown";
import { DEFAULT_CATEGORY, getCategory } from "../../../lib/categories";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/admin");
}

const env = Astro.locals.env;
let post: {
  title: string;
  date: string;
  tags: string[];
  category: string;
  description: string;
  status: string;
  content: string;
} | null = null;

if (env?.GITHUB_TOKEN) {
  try {
    const filePath = `src/posts/${slug}.md`;
    const url = `https://api.github.com/repos/Namrajp/learn-coding-first/contents/${filePath}`;
    const res = await fetch(url, {
      headers: {
        Authorization: `Bearer ${env.GITHUB_TOKEN}`,
        Accept: "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "learncodingfirst-blog",
      },
    });

    if (res.ok) {
      const json = (await res.json()) as { content: string; encoding: string };
      const raw = decodeURIComponent(
        atob(json.content)
          .split("")
          .map((c) => "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2))
          .join(""),
      );

      const parsed = parsePostFile(raw);
      if (parsed) {
        const { data: fm, body } = parsed;
        post = {
          title: fm.title || slug,
          date: fm.date,
          tags: fm.tags,
          category: fm.category,
          description: fm.description,
          status: fm.status,
          content: body,
        };
      }
    }
  } catch {
    // leave post as null
  }
}

if (!post) {
  return Astro.redirect("/admin");
}

const { html: htmlContent, toc } = renderMarkdown(post.content);
const postDate = new Date(post.date);
const category = getCategory(post.category ?? DEFAULT_CATEGORY);
---

<Layout
  frontmatter={{
    title: `${post.title} (Preview)`,
    description: post.description,
    date: postDate,
    tags: post.tags,
  }}
  title={`${post.title} — Preview`}
  tags={post.tags}
>
  <div class="mx-auto max-w-[65ch]">
    <div
      class="mb-6 flex items-center gap-4 rounded-lg border border-yellow-300 bg-yellow-50 px-4 py-3 dark:border-yellow-700 dark:bg-yellow-900/30"
    >
      <span class="text-sm font-medium text-yellow-800 dark:text-yellow-300">
        Draft Preview — not visible to public
      </span>
      <a
        href="/admin"
        class="ml-auto text-sm font-medium text-yellow-800 hover:underline dark:text-yellow-300"
      >
        Back to Admin
      </a>
    </div>

    {
      category && (
        <a
          href={`/category/${category.slug}`}
          class="mb-3 inline-block rounded-full bg-[hsl(21,62%,45%)]/10 px-3 py-1 text-xs font-semibold tracking-wide text-[hsl(21,62%,35%)] uppercase no-underline hover:bg-[hsl(21,62%,45%)]/20 dark:bg-[hsl(21,62%,45%)]/20 dark:text-[hsl(21,62%,70%)]"
        >
          {category.label}
        </a>
      )
    }
    <h1
      class="mb-2 text-3xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100"
    >
      {post.title}
    </h1>
    <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
      Namraj Pudasaini
    </p>
    <p class="mb-6 text-sm text-gray-500 dark:text-gray-400">
      {
        postDate.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric",
        })
      }
    </p>
    <TableOfContents items={toc} />
    <div class="prose dark:prose-invert">
      <Fragment set:html={htmlContent} />
    </div>
    <div class="my-4 space-x-2">
      {
        post.tags.map((tag) => (
          <a
            href={`/tag/${tag}`}
            class="rounded-lg px-2 py-1 text-gray-700 capitalize no-underline hover:text-[hsl(21,62%,45%)] dark:text-gray-300"
          >
            {tag}
          </a>
        ))
      }
    </div>
  </div>
</Layout>
