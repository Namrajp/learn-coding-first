---
import Layout from "../../../layouts/Layout.astro";
import {
  parseFrontmatter,
  parseFrontmatterBody,
} from "../../../lib/frontmatter";
import { CATEGORIES, DEFAULT_CATEGORY } from "../../../lib/categories";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/admin");
}

const env = Astro.locals.env;
let post = {
  title: "",
  tags: "",
  description: "",
  category: DEFAULT_CATEGORY as string,
  status: "draft",
  content: "",
};

if (env?.GITHUB_TOKEN) {
  try {
    const filePath = `src/posts/${slug}.md`;
    const url = `https://api.github.com/repos/Namrajp/learn-coding-first/contents/${filePath}`;
    const res = await fetch(url, {
      headers: {
        Authorization: `Bearer ${env.GITHUB_TOKEN}`,
        Accept: "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "learncodingfirst-blog",
      },
    });

    if (res.ok) {
      const json = (await res.json()) as { content: string; encoding: string };
      const raw = decodeURIComponent(
        atob(json.content)
          .split("")
          .map((c) => "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2))
          .join(""),
      );

      const fm = parseFrontmatter(raw);
      const body = parseFrontmatterBody(raw);

      if (fm && body) {
        post = {
          title: fm.title,
          tags: fm.tags.join(", "),
          description: fm.description,
          category: fm.category,
          status: fm.status,
          content: body.trim(),
        };
      }
    }
  } catch {
    // leave defaults
  }
}
---

<Layout title="Edit Post">
  <div class="mx-auto mt-10 max-w-6xl">
    <div class="mb-8 flex items-center justify-between">
      <h1 class="text-3xl font-bold dark:text-white">Edit Post</h1>
      <a
        href="/admin"
        class="text-gray-600 no-underline hover:text-[hsl(21,62%,45%)] dark:text-gray-400"
      >
        Back to Dashboard
      </a>
    </div>

    <form id="post-form" class="space-y-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-4">
        <div class="md:col-span-2">
          <label
            for="title"
            class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Title *
          </label>
          <input
            type="text"
            id="title"
            name="title"
            required
            value={post.title}
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
            placeholder="My Awesome Post"
          />
        </div>
        <div>
          <label
            for="tags"
            class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Tags (comma-separated)
          </label>
          <input
            type="text"
            id="tags"
            name="tags"
            value={post.tags}
            placeholder="python, django, api"
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
          />
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
            Category names are not allowed as tags and will be dropped.
          </p>
        </div>
        <div>
          <label
            for="category"
            class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Category *
          </label>
          <select
            id="category"
            name="category"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
          >
            {
              CATEGORIES.map((category) => (
                <option
                  value={category.slug}
                  selected={category.slug === post.category}
                >
                  {category.label}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <div>
        <label
          for="description"
          class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Description (optional)
        </label>
        <input
          type="text"
          id="description"
          name="description"
          value={post.description}
          class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
          placeholder="A brief description of your post"
        />
      </div>

      <div>
        <label
          for="status"
          class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Status
        </label>
        <select
          id="status"
          name="status"
          class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
        >
          <option value="draft" selected={post.status === "draft"}>Draft</option
          >
          <option value="published" selected={post.status === "published"}
            >Published</option
          >
        </select>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div>
          <label
            for="content"
            class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Markdown Content *
          </label>
          <textarea
            id="content"
            name="content"
            rows="25"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 font-mono text-sm leading-relaxed focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
            placeholder="# Hello World">{post.content}</textarea
          >
        </div>
        <div>
          <label
            class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Preview
          </label>
          <div
            id="preview"
            class="prose h-[600px] w-full max-w-none overflow-auto rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 dark:border-gray-700 dark:bg-gray-900"
          >
          </div>
        </div>
      </div>

      <div
        class="flex items-center gap-4 border-t border-gray-200 pt-4 dark:border-gray-700"
      >
        <button
          type="submit"
          class="rounded-lg bg-[hsl(21,62%,45%)] px-6 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
        >
          Update Post
        </button>
        <a
          href="/admin"
          class="rounded-lg border border-gray-300 px-6 py-2 font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          Cancel
        </a>
      </div>

      <div id="status-message" class="hidden"></div>
    </form>
  </div>

  <script>
    import { marked } from "marked";

    const slug = window.location.pathname.split("/").pop();
    const form = document.getElementById("post-form") as HTMLFormElement;
    const content = document.getElementById("content") as HTMLTextAreaElement;
    const preview = document.getElementById("preview") as HTMLDivElement;
    const statusMessage = document.getElementById(
      "status-message",
    ) as HTMLDivElement;

    marked.setOptions({ gfm: true, breaks: true });

    function renderPreview() {
      if (content.value.trim()) {
        preview.innerHTML = marked.parse(content.value) as string;
      }
    }

    renderPreview();
    content?.addEventListener("input", renderPreview);

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const title = (
        document.getElementById("title") as HTMLInputElement
      ).value.trim();
      const tags = (
        document.getElementById("tags") as HTMLInputElement
      ).value.trim();
      const category = (
        document.getElementById("category") as HTMLSelectElement
      ).value;
      const description = (
        document.getElementById("description") as HTMLInputElement
      ).value.trim();
      const markdownContent = content.value.trim();
      const status = (document.getElementById("status") as HTMLSelectElement)
        .value;

      if (!title || !markdownContent) {
        statusMessage.textContent = "Title and content are required";
        statusMessage.className = "mt-4 text-center text-red-600";
        return;
      }

      const button = form.querySelector(
        "button[type='submit']",
      ) as HTMLButtonElement;
      button.disabled = true;
      statusMessage.textContent = "Saving...";
      statusMessage.className = "mt-4 text-center text-gray-600";

      try {
        const response = await fetch("/api/posts/update", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            slug,
            title,
            content: markdownContent,
            description,
            tags,
            category,
            status,
          }),
        });

        const result = await response.json();

        if (response.ok) {
          statusMessage.textContent = "Post updated successfully!";
          statusMessage.className = "mt-4 text-center text-green-600";
          setTimeout(() => {
            window.location.href = "/admin";
          }, 1500);
        } else {
          statusMessage.textContent = result.error || "Failed to update post";
          statusMessage.className = "mt-4 text-center text-red-600";
          button.disabled = false;
        }
      } catch {
        statusMessage.textContent = "Network error. Please try again.";
        statusMessage.className = "mt-4 text-center text-red-600";
        button.disabled = false;
      }
    });
  </script>
</Layout>
