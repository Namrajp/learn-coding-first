---
import Layout from "../../../layouts/Layout.astro";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/admin");
}
---

<Layout title="Edit Post">
  <div class="mx-auto mt-10 max-w-6xl">
    <div class="mb-8 flex items-center justify-between">
      <h1 class="text-3xl font-bold dark:text-white">Edit Post</h1>
      <a href="/admin" class="text-gray-600 hover:text-[hsl(21,62%,45%)] dark:text-gray-400">
        Back to Dashboard
      </a>
    </div>

    <div id="loading" class="py-12 text-center text-gray-500">
      Loading post...
    </div>

    <form id="post-form" class="hidden space-y-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <label
            for="title"
            class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Title *
          </label>
          <input
            type="text"
            id="title"
            name="title"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
            placeholder="My Awesome Post"
          />
        </div>
        <div>
          <label
            for="tags"
            class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Tags (comma-separated)
          </label>
          <input
            type="text"
            id="tags"
            name="tags"
            placeholder="tutorial, python, ai"
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
          />
        </div>
      </div>

      <div>
        <label
          for="description"
          class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Description (optional)
        </label>
        <input
          type="text"
          id="description"
          name="description"
          class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
          placeholder="A brief description of your post"
        />
      </div>

      <div>
        <label
          for="status"
          class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Status
        </label>
        <select
          id="status"
          name="status"
          class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
        >
          <option value="draft">Draft</option>
          <option value="published">Published</option>
        </select>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div>
          <label
            for="content"
            class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Markdown Content *
          </label>
          <textarea
            id="content"
            name="content"
            rows="25"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 font-mono text-sm leading-relaxed focus:border-transparent focus:ring-2 focus:ring-[hsl(21,62%,45%)] dark:border-gray-600 dark:bg-gray-800 dark:text-white"
            placeholder="# Hello World

Write your post content here using Markdown...

## Section 1

Your content here.

```python
print('Hello, World!')
```"
          ></textarea>
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">
            Preview
          </label>
          <div
            id="preview"
            class="prose h-[600px] w-full max-w-none overflow-auto rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 dark:border-gray-700 dark:bg-gray-900"
          >
            <p class="text-gray-400 italic">
              Start typing to see the preview...
            </p>
          </div>
        </div>
      </div>

      <div class="flex gap-4 border-t border-gray-200 pt-4 dark:border-gray-700">
        <button
          type="submit"
          class="rounded-lg bg-[hsl(21,62%,45%)] px-6 py-2 font-medium text-white hover:bg-[hsl(21,62%,35%)]"
        >
          Update Post
        </button>
        <a
          href="/admin"
          class="rounded-lg border border-gray-300 px-6 py-2 font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          Cancel
        </a>
      </div>

      <div id="status-message" class="hidden"></div>
    </form>
  </div>

  <script>
    import { marked } from "marked";

    const slug = window.location.pathname.split("/").pop();
    const form = document.getElementById("post-form") as HTMLFormElement;
    const loading = document.getElementById("loading") as HTMLDivElement;
    const content = document.getElementById("content") as HTMLTextAreaElement;
    const preview = document.getElementById("preview") as HTMLDivElement;
    const statusMessage = document.getElementById(
      "status-message",
    ) as HTMLDivElement;

    // Configure marked for better rendering
    marked.setOptions({
      gfm: true,
      breaks: true,
    });

    // Live preview
    content?.addEventListener("input", () => {
      if (content.value.trim()) {
        preview.innerHTML = marked.parse(content.value) as string;
      } else {
        preview.innerHTML =
          '<p class="text-gray-400 italic">Start typing to see the preview...</p>';
      }
    });

    // Load post data
    async function loadPost() {
      try {
        const response = await fetch(`/api/posts/get?slug=${slug}`);
        if (!response.ok) {
          throw new Error("Failed to load post");
        }

        const post = await response.json();

        // Populate form fields
        (document.getElementById("title") as HTMLInputElement).value =
          post.title || "";
        (document.getElementById("tags") as HTMLInputElement).value =
          post.tags || "";
        (document.getElementById("description") as HTMLInputElement).value =
          post.description || "";
        (document.getElementById("status") as HTMLSelectElement).value =
          post.status || "draft";
        content.value = post.content || "";

        // Show preview
        if (post.content) {
          preview.innerHTML = marked.parse(post.content) as string;
        }

        // Show form, hide loading
        loading.classList.add("hidden");
        form.classList.remove("hidden");
      } catch {
        loading.textContent = "Failed to load post. Please try again.";
        loading.classList.add("text-red-600");
      }
    }

    loadPost();

    // Form submission
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const title = (
        document.getElementById("title") as HTMLInputElement
      ).value.trim();
      const tags = (
        document.getElementById("tags") as HTMLInputElement
      ).value.trim();
      const description = (
        document.getElementById("description") as HTMLInputElement
      ).value.trim();
      const markdownContent = content.value.trim();
      const status = (document.getElementById("status") as HTMLSelectElement)
        .value;

      if (!title || !markdownContent) {
        statusMessage.textContent = "Title and content are required";
        statusMessage.className = "mt-4 text-center text-red-600";
        return;
      }

      // Disable button during submission
      const button = form.querySelector(
        "button[type='submit']",
      ) as HTMLButtonElement;
      button.disabled = true;

      statusMessage.textContent = "Saving...";
      statusMessage.className = "mt-4 text-center text-gray-600";

      try {
        const response = await fetch("/api/posts/update", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            slug,
            title,
            content: markdownContent,
            description,
            tags,
            status,
          }),
        });

        const result = await response.json();

        if (response.ok) {
          statusMessage.textContent = "Post updated successfully!";
          statusMessage.className = "mt-4 text-center text-green-600";

          // Redirect to admin after a short delay
          setTimeout(() => {
            window.location.href = "/admin";
          }, 1500);
        } else {
          statusMessage.textContent = result.error || "Failed to update post";
          statusMessage.className = "mt-4 text-center text-red-600";
          button.disabled = false;
        }
      } catch {
        statusMessage.textContent = "Network error. Please try again.";
        statusMessage.className = "mt-4 text-center text-red-600";
        button.disabled = false;
      }
    });
  </script>
</Layout>
